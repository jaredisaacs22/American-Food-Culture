# ===========================================
# American Food Culture — Environment Config
# ===========================================
# Copy this file to .env and fill in your values.

# --- Anthropic (Claude API — content generation) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# --- OpenAI (DALL-E 3 — image generation) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

# --- Instagram Graph API ---
# Setup guide: https://developers.facebook.com/docs/instagram-api/getting-started
# 1. Create a Facebook App → add Instagram Graph API product
# 2. Connect your Instagram Professional (Business/Creator) account to a Facebook Page
# 3. Generate a long-lived Page Access Token (valid 60 days, auto-refreshed by this app)
# 4. Get your IG Business Account ID via: GET /{page-id}?fields=instagram_business_account
INSTAGRAM_ACCESS_TOKEN=your_long_lived_page_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# For automatic token refresh (optional but recommended):
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# --- Twitter / X API v2 ---
# 1. Developer portal: https://developer.x.com
# 2. Create project + app, enable OAuth 1.0a with Read + Write
# 3. Generate all four credentials below
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# --- Cloudinary (image hosting — Instagram requires public URLs) ---
# Free tier: https://cloudinary.com (25GB storage, 25GB bandwidth/month)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Scheduling ---
# Two-phase system: fill queue first, then post from queue.
# This means if generation fails at 7am, you still post at 10am from the queue.
FILL_CRON_SCHEDULE=0 7 * * *
POST_CRON_SCHEDULE=0 10 * * *
TIMEZONE=America/New_York
