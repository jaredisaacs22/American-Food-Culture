# ===========================================
# American Food Culture — Environment Config
# ===========================================

# --- Anthropic (Claude API for content generation) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# --- Instagram Graph API ---
# 1. Create a Facebook App at https://developers.facebook.com
# 2. Add "Instagram Graph API" product
# 3. Connect your Instagram Professional account to a Facebook Page
# 4. Generate a long-lived Page Access Token
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# --- Twitter / X API v2 ---
# 1. Apply for a developer account at https://developer.x.com
# 2. Create a project + app, enable OAuth 1.0a with read+write
# 3. Generate consumer keys and access tokens
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# --- Image Hosting (for Instagram — needs a public URL) ---
# Option A: Use Cloudinary (free tier)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Optional: Scheduling ---
# Cron expression for auto-posting (default: 10am EST daily)
CRON_SCHEDULE=0 10 * * *
TIMEZONE=America/New_York
